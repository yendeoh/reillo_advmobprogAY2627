rules_version = '2';

// LAB ACT 6: The handout sets `allow read, write: if true;`, which leaves the
// database open to anyone on the internet. Requiring a signed-in Firebase
// user keeps the lab working the same way while blocking anonymous access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
